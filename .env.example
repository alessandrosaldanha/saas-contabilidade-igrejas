# Crie um projeto em https://supabase.com, rode as migrations em supabase/migrations/
# e copie estes valores em Project Settings > API.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Crie um projeto em https://posthog.com e copie a Project API Key em Project Settings.
# Opcional: sem VITE_POSTHOG_KEY, o app roda normalmente com analytics desativado.
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_POSTHOG_HOST=https://us.i.posthog.com
